{
  "efficiency-router": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"${PLUGIN_ROOT:-.}/scripts/router.py\" hook || python3 scripts/router.py hook",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-.}/scripts/headroom_post_tool.py\" || python3 scripts/headroom_post_tool.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
